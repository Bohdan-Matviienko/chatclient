<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="8.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.chatclient.Controller"
      prefWidth="650.0" prefHeight="450.0">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <!-- Верхня панель: Автентифікація та Реєстрація (Лаб 07 + Лаб 08-09) -->
    <HBox spacing="8.0">
        <TextField fx:id="loginField" promptText="Логін (напр. user01)" HBox.hgrow="ALWAYS"/>
        <PasswordField fx:id="passwordField" promptText="Пароль (напр. 1111)"/>
        <Button fx:id="btnLogin" text="Ввійти" onAction="#onLogInClick"/>
        <Button fx:id="btnRegister" text="Реєстрація" onAction="#onRegisterClick"/>
    </HBox>

    <!-- Центральна частина: Поле чату + Список користувачів онлайн (Індивідуальне завдання Лаб 08-09) -->
    <HBox spacing="8.0" VBox.vgrow="ALWAYS">
        <TextArea fx:id="chatArea" editable="false" wrapText="true" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS"/>
        <VBox spacing="4.0" prefWidth="160.0">
            <Label fx:id="onlineCountLabel" text="Онлайн (0):" style="-fx-font-weight: bold;"/>
            <ListView fx:id="userListView" VBox.vgrow="ALWAYS"/>
            <Label text="* Клікніть по юзеру для приватного повідомлення" wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: gray;"/>
        </VBox>
    </HBox>

    <!-- Нижня панель: Відправлення повідомлення (Лаб 04-05) -->
    <HBox fx:id="sendMsgBox" spacing="8.0">
        <TextField fx:id="msgField" promptText="Напишіть повідомлення..." HBox.hgrow="ALWAYS" onAction="#sendMessage"/>
        <Button text="Відправити" onAction="#sendMessage"/>
    </HBox>
</VBox>
